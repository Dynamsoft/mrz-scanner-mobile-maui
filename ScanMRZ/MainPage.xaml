<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScanMRZ.MainPage"
             BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto" Padding="0">

        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="20">
            <!-- Status Label (centered, shown on cancel or error) -->
            <Label x:Name="LblStatus"
                   IsVisible="False"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="White"
                   FontSize="20"
                   Padding="30,0" />

            <!-- Shown only when camera access was denied, the one failure the user can fix -->
            <Button x:Name="BtnOpenSettings"
                    Text="Open Settings"
                    Clicked="OnOpenSettings"
                    IsVisible="False"
                    BackgroundColor="White"
                    TextColor="Black"
                    FontSize="16"
                    CornerRadius="8"
                    WidthRequest="180"
                    HeightRequest="44"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Bottom Button -->
        <Button Grid.Row="1"
                x:Name="ScanBtn"
                Text="Scan an MRZ"
                Clicked="OnScanMRZ"
                BackgroundColor="White"
                TextColor="Black"
                FontSize="18"
                CornerRadius="8"
                WidthRequest="150"
                HeightRequest="50"
                HorizontalOptions="Center"
                Margin="0,0,0,10" />
    </Grid>
</ContentPage>
